{
    "info": {
        "name": "Vacations System API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "How to use: 1) Run Auth > Login (user) and Login (admin) and copy each returned token (without the quotes) into the collection variables userToken and adminToken. 2) Run Vacations > Get all vacations and copy any _id into vacationId. 3) Now the protected requests work. Empty variables make the URL shrink to a different route, so fill them first."
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:4000"
        },
        {
            "key": "userToken",
            "value": ""
        },
        {
            "key": "adminToken",
            "value": ""
        },
        {
            "key": "vacationId",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"firstName\": \"New\",\n    \"lastName\": \"User\",\n    \"email\": \"new-user@example.com\",\n    \"password\": \"1234\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Login (User)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"moshe@vacations.com\",\n    \"password\": \"moshe1234\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Login (Admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"dana@vacations.com\",\n    \"password\": \"dana1234\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Vacations",
            "item": [
                {
                    "name": "Get Vacations (page + filter)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{userToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/vacations?page=1&filter=all",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "vacations"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "filter",
                                    "value": "all",
                                    "description": "all | liked | active | notStarted"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get One Vacation",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{userToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/vacations/{{vacationId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "vacations",
                                "{{vacationId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Add Vacation (Admin)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "destination",
                                    "value": "Test Destination",
                                    "type": "text"
                                },
                                {
                                    "key": "description",
                                    "value": "A long enough description for the new vacation.",
                                    "type": "text"
                                },
                                {
                                    "key": "startDate",
                                    "value": "2027-01-01",
                                    "type": "text"
                                },
                                {
                                    "key": "endDate",
                                    "value": "2027-01-10",
                                    "type": "text"
                                },
                                {
                                    "key": "price",
                                    "value": "999",
                                    "type": "text"
                                },
                                {
                                    "key": "image",
                                    "type": "file",
                                    "src": ""
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/vacations",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "vacations"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Vacation (Admin)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            }
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {
                                    "key": "destination",
                                    "value": "Test Destination Updated",
                                    "type": "text"
                                },
                                {
                                    "key": "description",
                                    "value": "An updated long enough description.",
                                    "type": "text"
                                },
                                {
                                    "key": "startDate",
                                    "value": "2027-01-01",
                                    "type": "text"
                                },
                                {
                                    "key": "endDate",
                                    "value": "2027-01-12",
                                    "type": "text"
                                },
                                {
                                    "key": "price",
                                    "value": "1099",
                                    "type": "text"
                                },
                                {
                                    "key": "image",
                                    "type": "file",
                                    "src": ""
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/vacations/{{vacationId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "vacations",
                                "{{vacationId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Vacation (Admin)",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/vacations/{{vacationId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "vacations",
                                "{{vacationId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Vacation Image",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/vacations/images/santorini-greece.jpg",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "vacations",
                                "images",
                                "santorini-greece.jpg"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Likes",
            "item": [
                {
                    "name": "Add Like",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{userToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/likes/{{vacationId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "likes",
                                "{{vacationId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Remove Like",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{userToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/likes/{{vacationId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "likes",
                                "{{vacationId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Reports",
            "item": [
                {
                    "name": "Get Likes Report (Admin)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/reports/likes",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "reports",
                                "likes"
                            ]
                        }
                    }
                },
                {
                    "name": "Download Likes CSV (Admin)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{adminToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/reports/likes/csv",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "reports",
                                "likes",
                                "csv"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "AI",
            "item": [
                {
                    "name": "Get Destination Recommendation",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{userToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"destination\": \"Santorini\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/ai/recommendation",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "ai",
                                "recommendation"
                            ]
                        }
                    }
                },
                {
                    "name": "Ask About Vacations (MCP Agent)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{userToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"question\": \"How many active vacations are there right now?\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/ai/ask",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "ai",
                                "ask"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}